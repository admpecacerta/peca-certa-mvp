// Prisma schema for Naka Acessórios, a marketplace focused on cell phone
// accessories such as cases, chargers, cables, films and earphones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Store {
  id           Int      @id @default(autoincrement())
  name         String
  url          String
  contactEmail String?
  region       String?
  active       Boolean  @default(true)
  syncMethod   String   @default("manual") // manual | api | feed | scraping | social
  syncConfig   String? // JSON string with feed, API or future social settings
  rating       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  offers       Offer[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  brand       String?
  phoneModel  String? // e.g. iPhone 15, Galaxy S24, Moto G84
  imageUrl    String?
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  offers      Offer[]
  alerts      Alert[]
}

model Offer {
  id           Int            @id @default(autoincrement())
  productId    Int
  storeId      Int
  price        Float
  originalUrl  String
  imageUrl     String?
  available    Boolean        @default(true)
  shipping     Float?
  lastSyncedAt DateTime       @default(now())
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]
  clicks       Click[]
}

model PriceHistory {
  id         Int      @id @default(autoincrement())
  offerId    Int
  price      Float
  recordedAt DateTime @default(now())
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
}

model Alert {
  id          Int      @id @default(autoincrement())
  productId   Int
  email       String
  targetPrice Float
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Click {
  id        Int      @id @default(autoincrement())
  offerId   Int
  clickedAt DateTime @default(now())
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
}
